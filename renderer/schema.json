{"$schema": "http://json-schema.org/draft-07/schema#", "title": "StudyStudio video spec", "type": "object", "required": ["title", "problem", "intro_seconds", "steps"], "properties": {"title": {"type": "string", "maxLength": 24}, "subtitle": {"type": "string", "maxLength": 24}, "problem": {"type": "string", "description": "問題文。／で改行。<r><b><g><o>..</>で色(<>で戻す)、_{}で下付き"}, "intro_seconds": {"type": "number"}, "steps": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "required": ["heading", "caption", "formula", "seconds"], "properties": {"heading": {"type": "string", "maxLength": 14}, "caption": {"type": "string", "description": "／で改行,最大2行"}, "formula": {"type": "string"}, "seconds": {"type": "number"}, "figure": {"type": "object", "description": "type=wave|point|graph", "properties": {"type": {"enum": ["wave", "point", "graph"]}, "label": {"type": "string"}, "wave": {"description": "type=wave: source_speed(px/s, 正=右へ), observer_side(left/right)"}, "point": {"description": "type=point: from,to (数直線の値), min,max, label"}, "graph": {"description": "type=graph: lines[{a,b,color,label}] (y=ax+b), xmin,xmax,ymin,ymax, mark:[x,y]"}}}}}}}, "description": "intro_seconds+sum(steps.seconds) = 30 (確認問題・類題は廃止)"}